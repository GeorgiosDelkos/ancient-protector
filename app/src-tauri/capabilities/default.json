{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The popover and settings: app commands, events, launch at login, the folder picker.",
  "windows": [
    "popover",
    "settings"
  ],
  "permissions": [
    "core:default",
    "autostart:allow-enable",
